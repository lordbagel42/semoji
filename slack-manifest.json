{
  "display_information": {
    "name": "Emoji Search",
    "description": "Private emoji catalog reconciliation for T0266FRGM",
    "background_color": "#202124"
  },
  "features": {
    "bot_user": { "display_name": "Emoji Search", "always_online": false }
  },
  "oauth_config": { "scopes": { "bot": ["emoji:read"] } },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://emojis.raygen.dev/slack/events",
      "bot_events": ["emoji_changed"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
