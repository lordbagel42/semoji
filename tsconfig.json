{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/indexer/**/*.ts",
    "src/shared.ts",
    "src/http.ts",
    "src/database.ts",
    "src/catalog.ts",
    "src/maintenance.ts"
  ]
}
